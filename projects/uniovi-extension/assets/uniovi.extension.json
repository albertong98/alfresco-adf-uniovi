{
    "$schema": "../../../extension.schema.json",
    "$id": "14157f82-6489-4187-9b68-1a5e38fadeca",
    "$name": "About Plugin",
    "$version": "0.0.1",
    "$vendor": "Alfresco Software, Ltd.",
    "$license": "LGPL-3.0",
    "appConfig":{
        "application":{
            "logo" : "assets/uniovi-extension/images/logo.png",
            "login_logo" : "assets/uniovi-extension/images/logo.png",
            "name": "Expedientes Uniovi"
        }
    },
    "features": {
        "create": [ 
            {
                "id": "create.record",
                "order": 905,
                "icon": "dvr",
                "title": "UNIOVI.NEW_MENU.CREATE_RECORD",
                "description": "UNIOVI.NEW_MENU.CREATE_RECORD",
                "actions": {
                    "click": "CREATE_RECORD"
                },
                "rules": {
                    "visible": "uniovi.canCreateRecord"
                }
            },
            {
                "id": "create.student",
                "order": 906,
                "icon": "account_box",
                "title": "UNIOVI.NEW_MENU.CREATE_STUDENT",
                "description": "UNIOVI.NEW_MENU.CREATE_STUDENT",
                "actions": {
                    "click": "CREATE_STUDENT"
                },
                "rules": {
                    "visible": "uniovi.canCreateStudent"
                }
            },
            {
                "id": "create.subject",
                "order": 907,
                "icon": "class",
                "title": "UNIOVI.NEW_MENU.CREATE_SUBJECT",
                "description": "UNIOVI.NEW_MENU.CREATE_SUBJECT",
                "actions": {
                    "click": "CREATE_SUBJECT"
                },
                "rules": {
                    "visible": "uniovi.canCreateSubject"
                }
            },
            {
                "id": "create.task",
                "order": 907,
                "icon": "assignment",
                "title": "UNIOVI.NEW_MENU.CREATE_TASK",
                "description": "UNIOVI.NEW_MENU.CREATE_TASK",
                "actions": {
                    "click": "CREATE_TASK"
                },
                "rules": {
                    "visible": "uniovi.canCreateTask"
                }
            }
        ],
        "task-list":{
            "baseQuery":"+TYPE:'uniovi:task'",
            "columns":[
                {
                    "id": "task-list.taskTitle",
                    "key": "properties.uniovi:taskTitle",
                    "type": "text",
                    "order": 1,
                    "cssClass": "ellipsis-cell",
                    "sortable": true
                },
                {
                    "id": "task-list.subjectUUID",
                    "key": "properties.uniovi:taskTitle",
                    "type": "text",
                    "order": 2,
                    "cssClass": "ellipsis-cell",
                    "sortable": true
