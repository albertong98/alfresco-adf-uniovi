        "task-list":{
            "baseQuery":"+TYPE:'uo:task'",
            "columns":[
                {
                    "id": "task-list.taskTitle",
                    "key": "properties.uo:taskTitle",
                    "title" : "UNIOVI.FORMS.TASK.TASK_TITLE.LABEL",
                    "type": "text",
                    "order": 1,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text",
                        "field":"uo:taskTitle"
                    }
                },
                {
                    "id": "task-list.subjectUUID",
                    "key": "properties.uo:subjectUUID",
                    "title" : "UNIOVI.FORMS.TASK.TASK_SUBJECT.LABEL",
                    "type": "text",
                    "order": 2,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text",
                        "field":"uo:subjectUUID"
                    }
                },
                {
                    "id": "task-list.description",
                    "key": "properties.uo:description",
                    "title" : "UNIOVI.FORMS.TASK.TASK_DESCRIPTION.LABEL",
                    "type": "text",
                    "order": 3,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text",
                        "field":"uo:description"
                    }
                },
                {
                    "id": "task-list.dueDate",
                    "key": "properties.uo:dueDate",
                    "title" : "UNIOVI.FORMS.TASK.TASK_DUEDATE.LABEL",
                    "format": "dd/MM/yyyy",
                    "type": "date",
                    "order": 4,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"date",
                        "field":"uo:dueDate"
                    }
                }
            ]
        },
        "student-task-list":{
            "baseQuery":"+TYPE:'uo:studentTask'",
            "columns":[
                {
                    "id": "student-task-list.status-img",
                    "key": "propertiesImage.uo:status",
                    "type": "image",
                    "order": 1,
                    "cssClass": "uniovi-datatable-image",
                    "sortable": true,
                    "search":{
                        "disabled": true
                    }
                },
                {
                    "id": "student-task-list.status",
                    "key": "properties.uo:status",
                    "title" : "UNIOVI.STUDENT_TASKS.FIELDS.STATUS",
                    "type": "text",
                    "order": 2,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"select",
                        "options":[
                            "Pendiente",
                            "Entregado",
                            "Aprobado",
                            "No entregado",
                            "Suspenso"
                        ],
                        "field":"uo:status"
                    }
                },
                {
                    "id": "student-task-list.title",
                    "key": "properties.uo:studentTaskTitle",
                    "title" : "UNIOVI.STUDENT_TASKS.FIELDS.TITLE",
                    "type": "text",
                    "order": 3,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text",
                        "field":"uo:parentTaskUUID"
                    }
                },
                {
                    "id": "student-task-list.dueDate",
                    "key": "properties.uo:studentTaskDueDate",
                    "title" : "UNIOVI.STUDENT_TASKS.FIELDS.DATE",
                    "type": "date",
                    "format": "dd/MM/yyyy",
                    "order": 3,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"date",
                        "field":"uo:studentDueDate"
                    }
                },
                {
                    "id": "student-task-list.score",
                    "key": "properties.uo:score",
                    "title" : "UNIOVI.STUDENT_TASKS.FIELDS.SCORE",
                    "type": "text",
                    "order": 4,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"number",
                        "field":"uo:score"
                    }
                }
            ]
        },
