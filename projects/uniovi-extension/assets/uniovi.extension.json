                        "field":"uo:center"
                    }
                },
                {
                    "id": "record-list.type",
                    "title" : "UNIOVI.FORMS.RECORD.RECORD_TYPE.LABEL",
                    "key": "properties.uo:type",
                    "type": "text",
                    "order": 5,
                    "sortable": true,
                    "search":{
                        "type":"text",
                        "field":"uo:type"
                    }
                },
                {
                    "id": "record-list.responsible",
                    "title" : "UNIOVI.FORMS.RECORD.RECORD_RESPONSIBLE.LABEL",
                    "key": "properties.uo:responsible",
                    "type": "text",
                    "order": 6,
                    "sortable": true,
                    "search":{
                        "type":"text",
                        "field":"uo:responsible"
                    }
                }
            ]
        },
        "student-list":{
            "baseQuery":"+TYPE:'uo:student'",
