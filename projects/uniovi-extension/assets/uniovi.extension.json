{
    "$schema": "../../../extension.schema.json",
    "$id": "14157f82-6489-4187-9b68-1a5e38fadeca",
    "$name": "About Plugin",
    "$version": "0.0.1",
    "$vendor": "Alfresco Software, Ltd.",
    "$license": "LGPL-3.0",
    "appConfig":{
        "application":{
            "logo" : "assets/uniovi-extension/images/logo.png",
            "login_logo" : "assets/uniovi-extension/images/logo.png",
            "name": "Expedientes Uniovi"
        }
    },
    "features": {
        "create": [
            {
                "id": "create.record",
                "order": 905,
                "icon": "dvr",
                "title": "UNIOVI.NEW_MENU.CREATE_RECORD",
                "description": "UNIOVI.NEW_MENU.CREATE_RECORD",
                "actions": {
                    "click": "CREATE_RECORD"
                },
                "rules": {
                    "visible": "uniovi.canCreateRecord"
                }
            },
            {
                "id": "create.student",
                "order": 906,
                "icon": "account_box",
                "title": "UNIOVI.NEW_MENU.CREATE_STUDENT",
                "description": "UNIOVI.NEW_MENU.CREATE_STUDENT",
                "actions": {
                    "click": "CREATE_STUDENT"
                },
                "rules": {
                    "visible": "uniovi.canCreateStudent"
                }
            },
            {
                "id": "create.subject",
                "order": 907,
                "icon": "class",
                "title": "UNIOVI.NEW_MENU.CREATE_SUBJECT",
                "description": "UNIOVI.NEW_MENU.CREATE_SUBJECT",
                "actions": {
                    "click": "CREATE_SUBJECT"
                },
                "rules": {
                    "visible": "uniovi.canCreateSubject"
                }
            },
            {
                "id": "create.task",
                "order": 907,
                "icon": "assignment",
                "title": "UNIOVI.NEW_MENU.CREATE_TASK",
                "description": "UNIOVI.NEW_MENU.CREATE_TASK",
                "actions": {
                    "click": "CREATE_TASK"
                },
                "rules": {
                    "visible": "uniovi.canCreateTask"
                }
            }
        ],
        "navbar": [
            {
                "id": "app.navbar.uniovi",
                "order": 1,
                "items": [
                    {
                        "id": "app.navbar.records",
                        "order": 1,
                        "icon": "dvr",
                        "title": "UNIOVI.RECORDS.TITLE",
                        "description": "UNIOVI.RECORDS.TITLE",
                        "route": "list/records",
                        "rules": {
                            "visible": "uniovi.canViewRecords"
                        }
                    },
                    {
                        "id": "app.navbar.students",
                        "order": 2,
                        "icon": "account_box",
                        "title": "UNIOVI.STUDENTS.TITLE",
                        "description": "UNIOVI.STUDENTS.TITLE",
                        "route": "list/students",
                        "rules": {
                            "visible": "uniovi.canViewStudents"
                        }
                    },
                    {
                        "id": "app.navbar.tasks",
                        "order": 3,
                        "icon": "assignment",
                        "title": "UNIOVI.TASKS.TITLE",
                        "description": "UNIOVI.TASKS.TITLE",
                        "route": "list/tasks",
                        "rules": {
                            "visible": "uniovi.canViewTasks"
                        }
                    },
                    {
                        "id": "app.navbar.tasks",
                        "order": 4,
                        "icon": "assignment",
                        "title": "UNIOVI.STUDENT_TASKS.TITLE",
                        "description": "UNIOVI.STUDENT_TASKS.TITLE",
                        "route": "list/student-tasks",
                        "rules": {
                            "visible": "uniovi.canViewTasks"
                        }
                    }
                ]
            }
        ],
        "task-list":{
            "baseQuery":"+TYPE:'uo:task'",
            "columns":[
                {
                    "id": "task-list.taskTitle",
                    "key": "properties.uo:taskTitle",
                    "type": "text",
                    "order": 1,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "task-list.subjectUUID",
                    "key": "properties.uo:taskTitle",
                    "type": "text",
                    "order": 2,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "task-list.description",
                    "key": "properties.uo:description",
                    "type": "text",
                    "order": 3,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "task-list.dueDate",
                    "key": "properties.uo:dueDate",
                    "format": "dd/MM/yyyy",
                    "type": "date",
                    "order": 4,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"date"
                    }
                }
            ]
        },
        "student-task-list":{
            "baseQuery":"+TYPE:'uo:studentTask'",
            "columns":[
                {
                    "id": "student-task-list.parentTaskUUID",
                    "key": "properties.uo:parentTaskUUID",
                    "type": "text",
                    "order": 1,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "student-task-list.status",
                    "key": "properties.uo:status",
                    "type": "text",
                    "order": 2,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"select",
                        "options":[
                            {"key":"01","value":"Pendiente"},
                            {"key":"02","value":"Entregado"},
                            {"key":"03","value":"Suspenso"},
                            {"key":"04","value":"Aprobado"},
                            {"key":"05","value":"No entregado"}
                        ]
                    }
                },
                {
                    "id": "student-task-list.score",
                    "key": "properties.uo:score",
                    "type": "text",
                    "order": 3,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"number"
                    }
                }
            ]
        },
        "record-list":{
            "baseQuery":"+TYPE:'uo:record'",
            "columns":[
                {
                    "id": "record-list.recordNumber",
                    "title" : "UNIOVI.FORMS.RECORD.RECORD_NUM.LABEL",
                    "key": "properties.uo:recordNumber",
                    "type": "text",
                    "order": 1,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "record-list.openingDate",
                    "title" : "UNIOVI.FORMS.RECORD.RECORD_DATE.LABEL",
                    "key": "properties.uo:openingDate",
                    "format": "dd/MM/yyyy",
                    "type": "date",
                    "order": 2,
                    "sortable": true,
                    "search":{
                        "type":"date"
                    }
                },
                {
                    "id": "record-list.recordTitle",
                    "title" : "UNIOVI.FORMS.RECORD.RECORD_TITLE.LABEL",
                    "key": "properties.uo:recordTitle",
                    "type": "text",
                    "order": 3,
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "record-list.center",
                    "title" : "UNIOVI.FORMS.RECORD.RECORD_CENTER.LABEL",
                    "key": "properties.uo:center",
                    "type": "text",
                    "order": 4,
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "record-list.type",
                    "title" : "UNIOVI.FORMS.RECORD.RECORD_TYPE.LABEL",
                    "key": "properties.uo:type",
                    "type": "text",
                    "order": 5,
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "record-list.responsible",
                    "title" : "UNIOVI.FORMS.RECORD.RECORD_RESPONSIBLE.LABEL",
                    "key": "properties.uo:responsible",
                    "type": "text",
                    "order": 6,
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                }
            ]
        },
        "student-list":{
            "baseQuery":"+TYPE:'uo:student'",
            "columns":[
                {
                    "id": "student-list.studentId",
                    "title" : "UNIOVI.FORMS.STUDENT.STUDENT_ID.LABEL",
                    "key": "properties.uo:studentId",
                    "type": "text",
                    "order": 1,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "student-list.studentUo",
                    "title" : "UNIOVI.FORMS.STUDENT.STUDENT_UO.LABEL",
                    "key": "properties.uo:studentUo",
                    "type": "text",
                    "order": 2,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "student-list.studentName",
                    "title" : "UNIOVI.FORMS.STUDENT.STUDENT_NAME.LABEL",
                    "key": "properties.uo:studentName",
                    "type": "text",
                    "order": 3,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "student-list.studentSurname",
                    "title" : "UNIOVI.FORMS.STUDENT.STUDENT_SURNAME.LABEL",
                    "key": "properties.uo:studentSurname",
                    "type": "text",
                    "order": 4,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "student-list.studentEmail",
                    "title" : "UNIOVI.STUDENTS.STUDENT_EMAIL",
                    "key": "properties.uo:studentEmail",
                    "type": "text",
                    "order": 5,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                }
            ]
        },
        "subject-list":{
            "baseQuery":"+TYPE:'uo:subject'",
            "columns":[
                {
                    "id": "student-list.schoolYear",
                    "title" : "UNIOVI.FORMS.SUBJECT.SUBJECT_SCHOOLYEAR.LABEL",
                    "key": "properties.uo:schoolYear",
                    "type": "text",
                    "order": 1,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                },
                {
                    "id": "student-list.subjectName",
                    "title" : "UNIOVI.FORMS.SUBJECT.SUBJECT_NAME.LABEL",
                    "key": "properties.uo:subjectName",
                    "type": "text",
                    "order": 2,
                    "cssClass": "ellipsis-cell",
                    "sortable": true,
                    "search":{
                        "type":"text"
                    }
                }
            ]
        }
    }
}
